<?xml version="1.0" encoding="utf-8"?>
<!-- Aucun trafic en clair : contrairement à la cible analysée, Selene n'autorise pas
     usesCleartextTraffic. Tout doit passer en TLS. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
